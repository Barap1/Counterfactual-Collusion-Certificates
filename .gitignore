# --- BOOT-001 additions (2026-10-23) ---
# local-only manifests / policies (paths, account details)
*.local.json
ops/environment.local.json
ops/resource_policy.local.json
.claude/settings.local.json
# raw pilot / experiment traces stay local until a sanitized release (hash manifest is tracked in ops/)
results/baselines/
results/raw/
# models, envs, caches, OS noise
*.gguf
*.safetensors
.venv/
__pycache__/
*.pyc
.DS_Store

# generated run artifacts (summaries tracked; raw branch dirs not)
docs/runner/dry-run-*/
runs/
docs/gate_a/gate_a_results.json
docs/runner/exp001-*/
docs/runner/exp002-*/
viewer/index.html
docs/runner/exp00*-live.log
docs/runner/exp00*-live.watchdog.log
docs/enh/bench/*/cache/
docs/runner/exp003-*/

# Build attempts are preserved locally by content hash; release candidate is tracked.
paper/v2/build/history/
paper/v2/build/.submission_v2.pdf.tmp

# Local presentation previews and worker logs (scientific records stay tracked).
.playwright-mcp/
ops/reports/codex_runs/*.log
ops/reports/codex_runs/*.pid
ops/reports/codex_runs/*.stdout
ops/reports/codex_runs/*.stderr
ops/reports/codex_runs/gate1_failed/
ops/reports/final_audit/FINAL_COMMIT.json
paper/build/
paper/v2/build/
paper/final/qa/
paper/final/submission.pdf
paper/final/submission.docx
# Machine-local test XML includes generated fixture identifiers/host metadata.
ops/reports/repo_final/*.xml
